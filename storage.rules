rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "davidburkett38@gmail.com"
      );
    }

    match /documents/{groupId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
